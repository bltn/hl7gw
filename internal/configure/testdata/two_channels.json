{
  "admin_api": {
    "port": 9000,
    "token_env": "GW_ADMIN"
  },
  "data_dir": "/var/lib/hl7gw",
  "tls_reload_interval_seconds": 30,
  "log": {
    "level": "debug",
    "format": "json"
  },
  "channels": [
    {
      "name": "adt",
      "tcp_listener": {
        "max_connections": 10,
        "port": 2575,
        "idle_timeout_seconds": 300,
        "tls": {
          "mode": "off"
        }
      },
      "destination": {
        "url": "https://api.example.com/hl7",
        "auth": {
          "type": "bearer",
          "token_env": "ADT_API_TOKEN"
        }
      }
    },
    {
      "name": "lab-results",
      "tcp_listener": {
        "max_connections": 64,
        "port": 2576,
        "idle_timeout_seconds": 60,
        "tls": {
          "mode": "mtls",
          "client_ca_path": "/etc/hl7gw/client-ca.pem",
          "server_cert_path": "/etc/hl7gw/server-cert.pem",
          "server_pk_path": "/etc/hl7gw/server-key.pem",
          "min_version": 1.3
        }
      },
      "destination": {
        "url": "http://10.0.0.5/hl7",
        "auth": {
          "type": "bearer",
          "token_env": "LAB_RESULTS_API_TOKEN"
        }
      }
    }
  ]
}
